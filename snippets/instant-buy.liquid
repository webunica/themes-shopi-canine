{%- assign is_preorder = false -%}
{%- if product.tags contains 'preventa' -%}
  {%- assign is_preorder = true -%}
{%- endif -%}

{% if product.available and is_preorder == false %}
<a href="javascript:void(0)" class="buy-btn" id="buyNow" onClick="instantBuy{{ product.id }}()">
  {{ 'products.product.buy_now' | t }}
</a>
{% endif %}

{% if is_preorder %}
<div class="preorder-note">
  <strong>PREVENTA:</strong> Producto disponible para despachar a partir del 07-12
</div>
<style>
  .preorder-note{
    margin-top: 12px;
    padding: 10px 14px;
    font-size: 14px;
    line-height: 1.4;
    border-radius: var(--sti-border-radius);
    background-color: rgba(0, 0, 0, 0.04);
    color: #333;
    text-align: center;
  }
  .preorder-note strong{
    color: var(--font-color-primary);
  }
</style>
{% endif %}

<script type="text/javascript">
  function instantBuy{{ product.id }}(){
    jQuery.post('/cart/add', $(".cart-{{ product.id }}").serialize()).
     always(function(data){
     window.location.href ='/checkout';
  });
  }
</script>
<style>
  a.buy-btn{
    background-color: var(--font-color-secondary);
    color: #ffffff;
    padding: 10px 30px;
    line-height: 1;
    height: 55px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    font-weight: var(--font-custom-weight-header);
    border-radius: var(--sti-border-radius);
    {% if settings.other_custom_font_handle_enable %}
    font-family: '{{ settings.other_custom_font_handle }}', sans-serif;
    {% endif %}
  }
  a.buy-btn:hover{
    color: #fff;
    background-color: var(--font-color-primary);
  }
  a.buy-btn[disabled],
  a.buy-btn.disabled{
    color: #eaeaea;
    background-color: #ababab;
    opacity: .65;
    pointer-events: none;
  }
  @media(max-width: 767px){
    a.buy-btn{
      margin-top: 10px;
      margin-left: 0px;
    }
  }
</style>